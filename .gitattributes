* text=auto
*.sh text eol=lf
mvnw text eol=lf
*.cmd text eol=crlf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
# The DEMO trademark data is checked against a sha256 in its manifest; keep it LF on every checkout (CRLF changes the hash)
catalogs/demo/raw/*.jsonl text eol=lf
# The published API contract (ADR-022): contract-sha256.txt hashes LF files; keep every checkout byte for byte the release asset
docs/api/**/*.json text eol=lf
# The POD profiles (ADR-048): the Console shows the SHA-256 of each file and PodProfilesTest pins it; keep every checkout LF
api/src/main/resources/pod/*.json text eol=lf
# The brand assets of the console (ADR-040): the CSS is compared line by line with the design pack; the binaries are never touched
docs/design/tokens.css text eol=lf
api/src/main/resources/static/brand/tokens.css text eol=lf
api/src/main/resources/static/brand/fonts/*.woff2 binary
api/src/main/resources/static/brand/icons/*.png binary
api/src/main/resources/static/brand/favicon.ico binary

# The synthetic trademark fixture is pinned by its byte hash.
eval/listing/trademark/cases.tsv text eol=lf
