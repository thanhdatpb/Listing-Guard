# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties
dependency-reduced-pom.xml
.mvn/wrapper/maven-wrapper.jar

# IDE - IntelliJ
.idea/
*.iml
*.ipr
*.iws
out/

# IDE - Eclipse
.classpath
.project
.settings/
bin/

# IDE - VS Code
.vscode/

# IDE - NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Env / secrets
.env
.env.local

# Raw policy documents (copyrighted marketplace text); only policies/manifest.yaml is committed
policies/raw/

# Raw trademark catalog data (third-party data under its own terms); only catalogs/manifest.yaml is committed
catalogs/raw/
!catalogs/manifest.yaml

# Batch check (docs/batch-check.md): real listing exports and the reports made from them are never committed; the
# mappings in batch/mappings/ are
batch/input/*
!batch/input/.gitkeep
batch/out/

# Claude Code local state
.claude/
