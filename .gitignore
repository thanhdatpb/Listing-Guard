# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties
dependency-reduced-pom.xml
.mvn/wrapper/maven-wrapper.jar

# IDE - IntelliJ
.idea/
*.iml
*.ipr
*.iws
out/

# IDE - Eclipse
.classpath
.project
.settings/
bin/

# IDE - VS Code
.vscode/

# IDE - NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Env / secrets
.env
.env.local

# Raw policy documents (copyrighted marketplace text); only policies/manifest.yaml is committed
policies/raw/

# Raw trademark catalog data (third-party data under its own terms); only catalogs/manifest.yaml is committed
catalogs/raw/
!catalogs/manifest.yaml

# deploy/oracle/uspto-sync.sh: its host lock and its run logs (ADR-009, PR A2d)
.uspto-sync.lock
.policy-diff.lock
# deploy/oracle/tsdr-status.sh: its host lock (its run logs are under logs/)
.tsdr-status.lock
logs/

# deploy/oracle/backup.sh writes database dumps here: they hold every client's stored results, so they are never committed
backups/

# Batch check (docs/batch-check.md): real listing exports and the reports made from them are never committed; the
# mappings in batch/mappings/ are
batch/input/*
!batch/input/.gitkeep
batch/out/

# Health report (ADR-018): the reports a run of the health-report job writes are never committed (they name clients and counts)
health-report/out/

# Policy change monitor reports can contain short excerpts of copyrighted policy text.
policy-monitor/out/

# Claude Code local state
.claude/

# Serena local state
.serena/

# JVM crash and replay dumps
hs_err_pid*.log
replay_pid*.log
