# Local Docker Desktop only. Never use the dev auth profile, localhost HTTP, or example DB password on a server.
COMPOSE_PROJECT_NAME=listing-guard-demo
API_BIND_HOST=127.0.0.1
API_PORT=8088
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=55438
POSTGRES_DB=listingguard
POSTGRES_USER=listingguard
POSTGRES_PASSWORD=listingguard
API_PROFILES=dev
LISTING_GUARD_DEV_API_KEY=
LISTING_GUARD_CONSOLE_ENABLED=true
LISTING_GUARD_CONSOLE_AUTH_MODE=MAGIC_LINK
LISTING_GUARD_CONSOLE_COOKIE_SECURE=false
LISTING_GUARD_CONSOLE_DEFAULT_LOCALE=vi
LISTING_GUARD_CONSOLE_POLICY_CHANGES_ENABLED=false
LISTING_GUARD_CONSOLE_POD_ENABLED=false
LISTING_GUARD_CONSOLE_PILOT=true
LISTING_GUARD_DEMO_ENABLED=true
LISTING_GUARD_DEMO_CLIENT_NAME=demo
LISTING_GUARD_PHRASE_SCREENING_ENABLED=true
# Seed selects the bundled fictional catalog for this tenant. Never set TRADEMARK_CATALOG_VERSION to DEMO.
LISTING_GUARD_TRADEMARK_RULESET=classpath:rulesets/trademark-risk-2026-11b.yaml
