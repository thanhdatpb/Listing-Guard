# Copy to .env.pilot on the server, chmod 600 and replace every placeholder.
# Use 0.11.0 after it is published. Verify both platforms and the catalog gate first.
COMPOSE_FILE=docker-compose.prod.yml:docker-compose.prod.cloudflared.yml
LISTING_GUARD_VERSION=0.11.0
POSTGRES_DB=REPLACE_WITH_DATABASE_NAME
POSTGRES_USER=REPLACE_WITH_DATABASE_USER
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
API_PORT=REPLACE_WITH_LOCAL_PORT
TUNNEL_TOKEN=REPLACE_WITH_TUNNEL_TOKEN
LISTING_GUARD_CONSOLE_ENABLED=true
LISTING_GUARD_CONSOLE_PILOT=true
LISTING_GUARD_CONSOLE_ROLE_HOME_ENABLED=true
LISTING_GUARD_CONSOLE_AUTH_MODE=CLOUDFLARE_ACCESS
LISTING_GUARD_CONSOLE_BASE_URL=https://REPLACE_WITH_HOST
LISTING_GUARD_CONSOLE_ACCESS_TEAM_DOMAIN=REPLACE_WITH_TEAM.cloudflareaccess.com
LISTING_GUARD_CONSOLE_ACCESS_AUD=REPLACE_WITH_APPLICATION_AUD
LISTING_GUARD_CONSOLE_ACCESS_ALLOWED_EMAILS=REPLACE_WITH_LEAD_AND_SELLER_EMAILS
LISTING_GUARD_CONSOLE_ACCESS_AUTO_CREATE=false
LISTING_GUARD_CONSOLE_DEFAULT_LOCALE=vi

# Pin a maintainer-checked jsonl-2 catalog, never a demo catalog.
TRADEMARK_CATALOG_VERSION=REPLACE_WITH_IMPORTED_CATALOG_VERSION
TRADEMARK_FOLLOW_ACTIVATION=false
# Owner-enriched catalogs must pass docs/catalog-activation-runbook.md before replacing this pinned version.
LISTING_GUARD_TRADEMARK_RULESET=classpath:rulesets/trademark-risk-2026-12.yaml
# ADR-039: the listing rulesets with the content rules (mojibake, placeholders, extra blanks, brackets, repeated words, capitals, and the size, quantity, recipient
# and product facts a copied listing tells two ways). Internal quality rules, WARNING only, not marketplace policy. Leave them out to keep etsy-2026-12 and amazon-2026-12c.
LISTING_GUARD_ETSY_RULESET=classpath:rulesets/etsy-2026-12b.yaml
LISTING_GUARD_AMAZON_RULESET=classpath:rulesets/amazon-2026-12d.yaml
LISTING_GUARD_FIXES_ENABLED=true

LISTING_GUARD_CONSOLE_POLICY_CHANGES_ENABLED=false
LISTING_GUARD_CONSOLE_POD_ENABLED=false
LISTING_GUARD_ANALYZER_ENABLED=false
LISTING_GUARD_REVIEW_CASES_ENABLED=false
LISTING_GUARD_VERIFIED_CASES_ENABLED=false
LISTING_GUARD_IMAGE_ENABLED=false
LISTING_GUARD_EMBEDDING_PROVIDER=none
LISTING_GUARD_LLM_ENABLED=false
LISTING_GUARD_LLM_JUDGE_ENABLED=false
LISTING_GUARD_LLM_REWRITE_ENABLED=false
LISTING_GUARD_PLANS_ENABLED=false

# Batch keyword and print-text trademark screening (only available in an image that contains ADR-055)
LISTING_GUARD_PHRASE_SCREENING_ENABLED=true

# Internal demo workspace stays disabled on the pilot server.
LISTING_GUARD_DEMO_ENABLED=false

# Console mode (ADR-064). "workspace": the menu and the home pages start from the listing workspace (Listings, Create new, Export file, Quick check) and the tools of
# a pasted Google Sheet (bulk check, edit before/after, re-audit by file, history of checks) are hidden: their paths answer 404. It takes effect ONLY while
# LISTING_GUARD_WORKSPACE_ENABLED=true (below); without the workspace the console stays "classic" and the start-up log says so once.
# NOT USING THE WORKSPACE (sellers who keep working in Google Sheets)? Set LISTING_GUARD_CONSOLE_MODE=classic (or delete the line) and keep
# LISTING_GUARD_WORKSPACE_ENABLED=false: the console is then exactly what it was. Read at start-up: restart after a change.
LISTING_GUARD_CONSOLE_MODE=workspace
# true keeps the four Sheet tools in the workspace mode (default false there; "classic" never hides them):
# LISTING_GUARD_CONSOLE_SHEET_TOOLS=false
# Who may import data into the workspace: ADMIN (default in the workspace mode) or ADMIN,MEMBER (the default of "classic"):
# LISTING_GUARD_WORKSPACE_IMPORT_ROLES=ADMIN

# Listing workspace and its background audit (ADR-059, ADR-061, docs/workspace.md). The workspace console mode above needs both ON: the workspace stores the
# listings, and without the audit the gate of "ready to export" (ADR-062, ADR-063) has no result to read and holds every listing back as "not checked".
# The audit needs the workspace and the Console; the e-mail alerts need the audit and the SMTP settings of the sign-in link (SPRING_MAIL_HOST,
# LISTING_GUARD_CONSOLE_MAIL_FROM) and stay off here.
# The multipart limits must be at least the import and template limits: the default import limit of 20 MB needs 25MB (the application refuses to start otherwise).
LISTING_GUARD_WORKSPACE_ENABLED=true
LISTING_GUARD_MULTIPART_MAX_FILE_SIZE=25MB
LISTING_GUARD_MULTIPART_MAX_REQUEST_SIZE=60MB
# ADR-062: with the audit on, an error, a HIGH trademark risk or a listing not checked in full holds a draft back from "ready to export" (an ADMIN can open the block).
# LISTING_GUARD_WORKSPACE_BLOCK_ON_ERROR=true
LISTING_GUARD_WORKSPACE_AUDIT_ENABLED=true
# How many runs are worked at once (1 to 8). One instance only: the queue is a PostgreSQL table and needs no broker.
# LISTING_GUARD_WORKSPACE_AUDIT_CONCURRENCY=2
# A periodic audit of every account, a Spring cron expression in UTC (empty: none), for example every day at 03:00:
# LISTING_GUARD_WORKSPACE_AUDIT_SCHEDULE_CRON=0 0 3 * * *
# LISTING_GUARD_WORKSPACE_AUDIT_KEEP_RUNS=30
# ADR-039: also compare a clone with its original (needs the audit; every clone is audited once more when this is turned on).
# LISTING_GUARD_WORKSPACE_AUDIT_CLONE_LEFTOVER=false
# One summary e-mail for each person after an audit that found a new risk, at most DAILY_CAP a day (UTC). Off by default.
LISTING_GUARD_WORKSPACE_ALERTS_EMAIL_ENABLED=false
# LISTING_GUARD_WORKSPACE_ALERTS_EMAIL_DAILY_CAP=3
