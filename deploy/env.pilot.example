# Copy to .env.pilot on the server, chmod 600 and replace every placeholder.
# Use 0.11.0 after it is published. Verify both platforms and the catalog gate first.
COMPOSE_FILE=docker-compose.prod.yml:docker-compose.prod.cloudflared.yml
LISTING_GUARD_VERSION=0.11.0
POSTGRES_DB=REPLACE_WITH_DATABASE_NAME
POSTGRES_USER=REPLACE_WITH_DATABASE_USER
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
API_PORT=REPLACE_WITH_LOCAL_PORT
TUNNEL_TOKEN=REPLACE_WITH_TUNNEL_TOKEN
LISTING_GUARD_CONSOLE_ENABLED=true
LISTING_GUARD_CONSOLE_PILOT=true
LISTING_GUARD_CONSOLE_AUTH_MODE=CLOUDFLARE_ACCESS
LISTING_GUARD_CONSOLE_BASE_URL=https://REPLACE_WITH_HOST
LISTING_GUARD_CONSOLE_ACCESS_TEAM_DOMAIN=REPLACE_WITH_TEAM.cloudflareaccess.com
LISTING_GUARD_CONSOLE_ACCESS_AUD=REPLACE_WITH_APPLICATION_AUD
LISTING_GUARD_CONSOLE_ACCESS_ALLOWED_EMAILS=REPLACE_WITH_LEAD_AND_SELLER_EMAILS
LISTING_GUARD_CONSOLE_ACCESS_AUTO_CREATE=false
LISTING_GUARD_CONSOLE_DEFAULT_LOCALE=vi

# Pin a maintainer-checked jsonl-2 catalog, never a demo catalog.
TRADEMARK_CATALOG_VERSION=REPLACE_WITH_IMPORTED_CATALOG_VERSION
TRADEMARK_FOLLOW_ACTIVATION=false
# Owner-enriched catalogs must pass docs/catalog-activation-runbook.md before replacing this pinned version.
LISTING_GUARD_TRADEMARK_RULESET=classpath:rulesets/trademark-risk-2026-12.yaml
LISTING_GUARD_FIXES_ENABLED=true

LISTING_GUARD_CONSOLE_POLICY_CHANGES_ENABLED=false
LISTING_GUARD_CONSOLE_POD_ENABLED=false
LISTING_GUARD_ANALYZER_ENABLED=false
LISTING_GUARD_REVIEW_CASES_ENABLED=false
LISTING_GUARD_VERIFIED_CASES_ENABLED=false
LISTING_GUARD_IMAGE_ENABLED=false
LISTING_GUARD_EMBEDDING_PROVIDER=none
LISTING_GUARD_LLM_ENABLED=false
LISTING_GUARD_LLM_JUDGE_ENABLED=false
LISTING_GUARD_LLM_REWRITE_ENABLED=false
LISTING_GUARD_PLANS_ENABLED=false
