# Copy to .env on the server, replace every placeholder, and restrict file permissions.
LISTING_GUARD_VERSION=REPLACE_WITH_RELEASE_VERSION
POSTGRES_DB=REPLACE_WITH_DATABASE_NAME
POSTGRES_USER=REPLACE_WITH_DATABASE_USER
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
API_PORT=REPLACE_WITH_LOCAL_API_PORT
# Resource caps sized for an Oracle A1 instance with 2 OCPUs and 12 GB RAM. Increase these on a larger host;
# leave enough memory for Ubuntu, Docker, the database cache and optional services.
API_MEM_LIMIT=2g
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
POSTGRES_MEM_LIMIT=4g
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAX_CONNECTIONS=50

# Required only when docker-compose.prod.cloudflared.yml is enabled. Create the tunnel in the Cloudflare dashboard and
# keep its token secret. The tunnel container connects to api:8080 over Docker's private network.
TUNNEL_TOKEN=

# Local database dump retention. Optional S3-compatible upload settings (Cloudflare R2 is the selected off-host target):
# set BACKUP_S3_BUCKET and credentials together; install/configure the AWS CLI on the host first. Uploads use daily/
# by default; the Sunday cron job uploads a separate weekly/ recovery point. Set matching 7-day and 28-day R2 rules.
BACKUP_RETENTION_COUNT=14
# BACKUP_S3_BUCKET=REPLACE_WITH_BUCKET
# BACKUP_S3_PREFIX=listing-guard
# BACKUP_S3_ENDPOINT=https://REPLACE_WITH_S3_COMPATIBLE_ENDPOINT
# BACKUP_S3_REGION=REPLACE_WITH_REGION
# BACKUP_S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
# BACKUP_S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET
# BACKUP_S3_SESSION_TOKEN=REPLACE_WITH_SESSION_TOKEN_IF_USED

# Optional (ADR-012). By default no embedding model is used and nothing here is needed: the rule checks work on
# their own. To use policy retrieval, set the provider to `api` and the key of the embedding API (Google Gemini);
# the api service then does not start while the key is empty. Leave both lines commented otherwise.
# LISTING_GUARD_EMBEDDING_PROVIDER=api
# LISTING_GUARD_EMBEDDING_API_KEY=REPLACE_WITH_THE_EMBEDDING_API_KEY

# Optional trademark catalog (ADR-009). Empty means trademark checks are off and `/checks` is not affected. After you
# import a catalog with the `trademark-import` job (docs/deployment.md), set this to the version the job prints
# (`<label>-<digest>`, never "latest") and restart the api. The `api` and `batch-check` services both read it.
# Never use a `demo-` version in a deployment other people use. You are responsible for the terms of your data source.
TRADEMARK_CATALOG_VERSION=

# Optional USPTO catalog sync (ADR-009, PR A2d; docs/deploy-oracle.md section 8). true makes the api, batch-check and
# health-report serve the catalog version the activation log names (the uspto-sync job activates one after an import that
# succeeded; `admin catalog rollback` goes back). TRADEMARK_CATALOG_VERSION must then be empty, or the api does not start.
TRADEMARK_FOLLOW_ACTIVATION=false
# Required before the uspto-sync job runs: the terms of the USPTO data, as you checked them; stored with every catalog version.
# USPTO_SYNC_LICENSE=USPTO bulk data, public domain (checked by REPLACE_WITH_WHO on REPLACE_WITH_DATE)
# Catalog versions the sync keeps for a rollback (at least 2). Each is a full copy of the entries in the database and backups.
# USPTO_SYNC_KEEP_VERSIONS=3
# Memory of the sync container; the conversion holds one number per USPTO serial number (USPTO_MAX_DISTINCT_SERIALS).
# USPTO_SYNC_MEM_LIMIT=3g
# USPTO_MAX_DISTINCT_SERIALS=20000000
# The ODP download is off: every endpoint is unverified. With a key, follow the verification steps of ADR-009 first.
# USPTO_SYNC_DOWNLOAD_ENABLED=false
# LISTING_GUARD_USPTO_ODP_API_KEY=REPLACE_WITH_THE_ODP_API_KEY
# deploy/oracle/uspto-sync.sh: warn below, and refuse to start below, this much free disk (GB); run logs kept.
# USPTO_SYNC_WARN_FREE_GB=30
# USPTO_SYNC_MIN_FREE_GB=15
# USPTO_SYNC_LOG_RETENTION=30

# TSDR status check (ADR-009, "TSDR status check"; the tsdr-status job). It checks whether marks that findings still name are
# dead in the USPTO TSDR and reports them as a proposal for the next catalog sync; it changes no catalog. The calls are off: the
# job then reads TSDR files you saved yourself (--input-dir). The key header and the status field names are unverified.
# TSDR_DOWNLOAD_ENABLED=false
# LISTING_GUARD_TSDR_API_KEY=REPLACE_WITH_THE_TSDR_API_KEY
# The most marks one run asks about (the TSDR allows 60 requests per key per minute; the job waits 2 s between requests).
# TSDR_MAX_MARKS=100
# Of those, how many may be marks no recent finding named (0: only marks that findings named).
# TSDR_UNMATCHED_PER_RUN=0
# A mark that was answered is not asked about again within this time.
# TSDR_RECHECK_INTERVAL=30d
# TSDR_STATUS_MEM_LIMIT=1g
# true adds the last TSDR status and its check date to each trademark finding of the api (an optional member). Off: the answer
# is unchanged. Turn it on only after the job has stored statuses.
# TSDR_FINDING_STATUS_ENABLED=false
# deploy/oracle/tsdr-status.sh: log files kept.
# TSDR_STATUS_LOG_RETENTION=30

# Optional, only with docker-compose.prod.shared-network.yml: the name of an existing Docker network that another
# application on this host also joins, so it can call the API at http://listing-guard-api:8080 without a published port.
# Create it once with `docker network create <name>`. The base docker-compose.prod.yml does not read this.
# LISTING_GUARD_SHARED_NETWORK=REPLACE_WITH_THE_SHARED_NETWORK_NAME

# Optional convenience for operator commands and deploy/oracle/backup.sh + restore.sh. Compose uses `:` between files.
# For a tunnel, uncomment the cloudflared override; add the shared-network file only when Preview needs private access.
# COMPOSE_FILE=docker-compose.prod.yml:docker-compose.prod.cloudflared.yml
# COMPOSE_FILE=docker-compose.prod.yml:docker-compose.prod.cloudflared.yml:docker-compose.prod.shared-network.yml

# Optional web console (ADR-014 B2). Leave disabled unless SMTP and the HTTPS public URL are configured.
# LISTING_GUARD_CONSOLE_ENABLED=true
# LISTING_GUARD_CONSOLE_BASE_URL=https://console.example.com
# LISTING_GUARD_CONSOLE_MAIL_FROM=noreply@example.com
# Language of a console page whose reader has not chosen one (ADR-028): en or vi.
# LISTING_GUARD_CONSOLE_DEFAULT_LOCALE=vi
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
# SPRING_MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
