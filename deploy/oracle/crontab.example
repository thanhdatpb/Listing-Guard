# Run as deploy. Keep the environment file and backups readable only by trusted operators.
# Daily custom-format PostgreSQL backup; local retention is controlled by BACKUP_RETENTION_COUNT.
15 2 * * * cd /opt/listing-guard && ./deploy/oracle/backup.sh

# Weekly off-host recovery point under the R2 `weekly/` prefix (set the matching lifecycle rule to 28 days).
45 2 * * 0 cd /opt/listing-guard && BACKUP_S3_TIER=weekly ./deploy/oracle/backup.sh

# Weekly report for every active client, saved under health-report/out/.
0 3 * * 1 cd /opt/listing-guard && docker compose -f docker-compose.prod.yml --profile prod --profile tools run --rm health-report --all-clients

# USPTO catalog sync (ADR-009, PR A2d; docs/deploy-oracle.md section 8). Leave it commented until the ODP download is
# verified and USPTO_SYNC_DOWNLOAD_ENABLED=true: offline runs (--input-dir) are started by hand. Once a day, after the
# USPTO has published the day's file; the release time is unverified, 11:00 UTC is a guess to adjust. The script holds a
# lock (a run still converting makes the next one exit with 75), checks free disk and logs to logs/uspto-sync/.
# 0 11 * * * cd /opt/listing-guard && ./deploy/oracle/uspto-sync.sh

# TSDR status check (ADR-009, "TSDR status check"; docs/deploy-oracle.md section 8a). Weekly, on Sunday after the USPTO sync, so
# the marks it asks about come from the catalog the sync has just activated. Leave it commented until you have a TSDR key and
# TSDR_DOWNLOAD_ENABLED=true (the key header and the status field names are unverified: run `--dry-run` and one small
# `--max-marks=5` run by hand first). It only proposes: it reads the findings' source ids and the dates of retained checks,
# writes catalogs/raw/tsdr/out/<UTC timestamp>/report.json and dead-marks.csv, and changes no catalog. The script holds a lock
# (a second run exits with 75) and logs to logs/tsdr-status/. A non-zero exit means it stopped early (a refused key, a limit
# that lasts): cron mails it.
# 30 12 * * 0 cd /opt/listing-guard && ./deploy/oracle/tsdr-status.sh

# Policy changes are saved by a maintainer first; this monthly job only compares local files and writes reports.
# 0 5 1 * * cd /opt/listing-guard && ./deploy/oracle/policy-diff.sh

# Remove dangling image layers only; tagged previous releases remain available for rollback.
30 4 * * 0 cd /opt/listing-guard && docker image prune --force
