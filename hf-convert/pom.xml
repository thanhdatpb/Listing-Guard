<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.thanhdatpb.listingguard</groupId>
        <artifactId>listing-guard</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>hf-convert</artifactId>
    <name>Listing Guard :: Hugging Face catalog converter</name>
    <description>One-shot job (ADR-030): converts the Hugging Face USPTO trademark Parquet dataset to a jsonl-1 catalog file
        with DuckDB. A jar of its own: DuckDB is never on the API's classpath. No Spring, no database, no network unless
        allowed.</description>

    <properties>
        <!--
            DuckDB JDBC: the jar bundles the native library for linux amd64/arm64, macOS and Windows amd64 (about 85 MB).
            1.5.6.0 (2026-09-28) is the last release of the 1.5 line; 2.0.0.x appeared on 2026-10-21 and is not used yet
            (ADR-030). Only this module depends on it.
        -->
        <duckdb.version>1.5.6.0</duckdb.version>
        <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
    </properties>

    <dependencies>
        <!-- The normalizer of the active trademark ruleset and CatalogImport's limits; plain Java, no Spring. -->
        <dependency>
            <groupId>com.thanhdatpb.listingguard</groupId>
            <artifactId>trademark-scanner</artifactId>
        </dependency>
        <dependency>
            <groupId>org.duckdb</groupId>
            <artifactId>duckdb_jdbc</artifactId>
            <version>${duckdb.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- trademark-scanner logs through slf4j; the job writes its own lines to standard error. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven-shade-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>listing-guard-hf-convert</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Main-Class>com.thanhdatpb.listingguard.hfconvert.HfConvertMain</Main-Class>
                                        <Implementation-Title>listing-guard-hf-convert</Implementation-Title>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                        <Multi-Release>true</Multi-Release>
                                        <!-- DuckDB loads a native library (JNI); JDK 24+ warns without this. -->
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
