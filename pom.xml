<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.thanhdatpb.listingguard</groupId>
    <artifactId>listing-guard</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Listing Guard</name>
    <description>Pre-publish listing checker: deterministic rule engine plus RAG analyzer.</description>

    <modules>
        <module>core</module>
        <module>rule-engine</module>
        <module>rag-analyzer</module>
        <module>trademark-scanner</module>
        <module>variation-checks</module>
        <module>personalization-screening</module>
        <module>image-checker</module>
        <module>api</module>
        <module>mcp-server</module>
        <module>contract-tools</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.1.2</spring-boot.version>
        <!--
            Jackson 2 (com.fasterxml.jackson). Its BOM is imported before the Spring Boot BOM so that it wins over the
            Boot BOM's jackson-2-bom (2.21.7 in Boot 4.1.2). Pinned to 2.21.8 for a security reason: the Trivy scan of the
            v0.6.0 image (commit 4157547) reported findings that 2.21.8 fixes. Boot 4's own jackson-bom.version is
            Jackson 3 (tools.jackson) and is not touched here. Drop this pin when the Boot BOM reaches 2.21.8 or the
            repository moves to Jackson 3 (ADR-020).
        -->
        <jackson-2-bom.version>2.23.0</jackson-2-bom.version>
        <!--
            The release version of this build, sent by the API as X-Listing-Guard-Version (ADR-022). `dev` unless the build
            names one: the release workflow builds the image with -Dlisting-guard.release=<tag without the v> (Dockerfile
            argument LISTING_GUARD_RELEASE). The project version stays 0.1.0-SNAPSHOT; it is not the release.
        -->
        <listing-guard.release>dev</listing-guard.release>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson-2-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.thanhdatpb.listingguard</groupId>
                <artifactId>core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.thanhdatpb.listingguard</groupId>
                <artifactId>rule-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.thanhdatpb.listingguard</groupId>
                <artifactId>rag-analyzer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.thanhdatpb.listingguard</groupId>
                <artifactId>trademark-scanner</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.thanhdatpb.listingguard</groupId>
                <artifactId>variation-checks</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.thanhdatpb.listingguard</groupId>
                <artifactId>personalization-screening</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.thanhdatpb.listingguard</groupId>
                <artifactId>image-checker</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
